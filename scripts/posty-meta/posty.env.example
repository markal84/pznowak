# Konfiguracja skryptu postów pracowni (scripts/posty-meta/posty.mjs).
# Skopiuj na serwer jako ~/pznowak-posty/posty.env i ustaw prawa: chmod 600 ~/pznowak-posty/posty.env
# Tokenów i haseł NIE wpisuj do repo ani do czatu – tylko do tego pliku na serwerze.
# Puste albo zakomentowane = wartość domyślna (podana w komentarzu).

# ===== Facebook =====
# Numer strony „Michał Nowak Pracownia Złotnicza” w Graph API.
META_PAGE_ID=518148711375873
# Token strony bez daty wygaśnięcia. Najprościej wpisać go komendą: node posty.mjs --wymien-token (README, „Token”).
META_PAGE_TOKEN=
# Wersja Graph API.
META_API_VERSION=v27.0
# ID i sekret aplikacji (panel Meta → Ustawienia aplikacji → Podstawowe). Potrzebne do --wymien-token
# i do codziennego sprawdzania, kiedy wygasa token. Sekret dodaje też appsecret_proof do zapytań.
META_APP_ID=
META_APP_SECRET=

# ===== Co i jak często sprawdzać =====
# Źródła oddzielone przecinkami: posts (posty strony), video_reels (rolki), instagram (firmowy IG, gdy będzie dostęp).
SOURCES=posts,video_reels
# Co ile godzin sprawdzać. Cron uruchamia skrypt co godzinę, a skrypt sam pomija uruchomienia, gdy jest za wcześnie.
# Można podać ułamek, np. 0.5. 0 = przy każdym uruchomieniu z crona.
INTERVAL_HOURS=6
# Ile dni wstecz przeglądać przy każdym sprawdzeniu (łapie posty z datą wsteczną i zaplanowane). Domyślnie 14.
LOOKBACK_DAYS=14
# Pierwsze uruchomienie: posty z ilu ostatnich dni pobrać. 0 = cała historia strony.
FIRST_RUN_DAYS=7
# Bezpiecznik: najwyżej tyle stron wyników (po 25 postów) na źródło w jednym uruchomieniu.
MAX_PAGES=20

# ===== Gdzie zapisywać =====
# Katalog na posty (posty/<data>_<id>/), stan (stan.json) i spis (indeks.json). Poza katalogiem strony www.
DATA_DIR=~/pznowak-posty/dane
# Czy pobierać zdjęcia i filmy (1 = tak, 0 = nie; wtedy zapisuje się tylko treść i link).
DOWNLOAD_PHOTOS=1
DOWNLOAD_VIDEOS=1
# Zdjęcia w największej dostępnej rozdzielczości (jedno dodatkowe zapytanie na zdjęcie).
PHOTO_FULL_RES=1
# Pliki większe niż tyle MB są pomijane (z mailem).
MAX_FILE_MB=500
# Ile uruchomień z rzędu ponawiać pobieranie plików posta, zanim skrypt odpuści i napisze o tym mail.
MAX_RETRIES=5

# ===== Instagram (później) =====
# IG user id firmowego konta. Puste = skrypt sam odczyta konto podpięte do strony.
IG_USER_ID=
# Osobny token do Instagrama (np. z aplikacji „Agregat postow”). Puste = token strony.
IG_TOKEN=
# Sekret aplikacji, z której jest IG_TOKEN (tylko gdy IG_TOKEN jest z innej aplikacji niż META_APP_SECRET).
IG_APP_SECRET=

# ===== Powiadomienia =====
# Adresy oddzielone przecinkami. Puste = bez maili (wszystko tylko w logu).
NOTIFY_TO=
# Mail o nowych postach (1/0) i o problemach (1/0).
NOTIFY_NEW_POSTS=1
NOTIFY_ERRORS=1
# Przejściowe problemy (brak sieci, limit zapytań) zgłaszaj dopiero po tylu nieudanych uruchomieniach z rzędu.
# Problemy z tokenem i uprawnieniami idą od razu.
ERROR_MAIL_AFTER=3
# Ten sam problem przypominaj najwyżej raz na tyle godzin.
ERROR_REPEAT_HOURS=24
# Ostrzeż mailem, gdy token wygasa w ciągu tylu dni.
TOKEN_WARN_DAYS=14
# Sposób wysyłki: smtp (skrzynka pracowni, jak formularz na stronie), sendmail (systemowy) albo none.
MAIL_METHOD=smtp
# Dane SMTP można wziąć z pliku env strony (czytane są tylko zmienne SMTP_*):
SMTP_ENV_FILE=~/pznowak-cms-prod/cms/.env.production.local
# …albo wpisać tutaj (mają pierwszeństwo przed SMTP_ENV_FILE):
#SMTP_HOST=
#SMTP_PORT=465
#SMTP_USER=
#SMTP_PASS=
# Nadawca. Puste = „Posty pznowak <adres z SMTP_FROM>”. Adres musi być adresem skrzynki z SMTP_USER.
MAIL_FROM=
MAIL_SUBJECT_PREFIX=[Posty pznowak]
# Najwyżej tyle postów wypisanych w jednym mailu (reszta: indeks.json).
MAIL_MAX_ITEMS=20
SENDMAIL_PATH=/usr/sbin/sendmail

# ===== Techniczne =====
TIMEZONE=Europe/Warsaw
REQUEST_TIMEOUT_S=60
