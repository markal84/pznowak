DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/pznowak_catalog?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/pznowak_catalog?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME
PAYLOAD_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Zgłoszenia z kreatora i formularza kontaktowego (etap 2). Wartości tylko w zmiennych środowiskowych:
# Vercel osobno Preview i Production, lokalnie .env.local. Lokalnie i na preview: klucze testowe Cloudflare
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/); na produkcji: klucze widżetu pznowak.pl.
# Bez NEXT_PUBLIC_TURNSTILE_SITE_KEY formularze nie wysyłają; bez TURNSTILE_SECRET_KEY endpoint odpowiada 503.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Statystyki odwiedzin Umami (bez cookies, docs/analityka/README.md). Wstawiane przy `next build`, więc po zmianie
# trzeba przebudować stronę. Puste ID = brak skryptu. Liczą się tylko wizyty na domenie z SITE_URL
# (albo z NEXT_PUBLIC_UMAMI_DOMAINS, lista po przecinku). NEXT_PUBLIC_UMAMI_SRC tylko przy własnej instancji Umami.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_DOMAINS=
# Limity (puste = domyślne 5 / 40 / 10) i tryb kolejki wizualizacji: manual (domyślnie) albo auto.
SUBMISSIONS_LIMIT_PER_IP_HOUR=
SUBMISSIONS_LIMIT_PER_DAY=
VISUALIZATIONS_LIMIT_PER_DAY=
VISUALIZATIONS_MODE=
# Adres pracowni dla powiadomień; działa dopiero po dodaniu adaptera poczty Payloada (patrz raport etapu 2).
SUBMISSIONS_NOTIFY_TO=

# Zdjęcia od klientów w formularzu kontaktowym (Zlecenie B). Domyślnie wyłączone; włącza 1 albo true
# (wymaga ponownego zbudowania, bo przełącznik trafia też do przeglądarki).
ATTACHMENTS_ENABLED=
# PRYWATNY magazyn Vercel Blob (osobny, z dostępem „Private”, nie ten od katalogu). Podłączony w panelu
# z przedrostkiem zmiennych ATTACHMENTS_BLOB daje ATTACHMENTS_BLOB_STORE_ID (OIDC, bez tokenu); albo token.
# Bez magazynu zgłoszenia przychodzą bez zdjęć. Lokalnie zamiast tego: ATTACHMENTS_STORAGE=local.
ATTACHMENTS_BLOB_STORE_ID=
ATTACHMENTS_BLOB_READ_WRITE_TOKEN=
ATTACHMENTS_STORAGE=
# Limity plików na dobę (puste = domyślne 15 plików / 40 MB z IP, 100 plików / 300 MB łącznie).
ATTACHMENTS_LIMIT_FILES_PER_IP_DAY=
ATTACHMENTS_LIMIT_MB_PER_IP_DAY=
ATTACHMENTS_LIMIT_FILES_PER_DAY=
ATTACHMENTS_LIMIT_MB_PER_DAY=
# Sekret zadania cyklicznego Vercela (sprzątanie zdjęć); bez niego sprzątanie odpowiada 503.
CRON_SECRET=

# SEO (Zlecenie D). SITE_ENV=production włącza indeksowanie (robots.txt, meta robots, brak nagłówka X-Robots-Tag);
# pusta wartość albo inna (np. preview) zostawia noindex. Ma pierwszeństwo przed VERCEL_ENV, więc działa tak samo
# na Vercelu i na własnym serwerze. Wartość trafia do stron i nagłówków zapisanych PRZY BUDOWANIU: ustaw ją
# już na czas `next build`, nie tylko przy uruchamianiu serwera.
SITE_ENV=
# Adres serwisu w adresach kanonicznych, mapie strony i Open Graph (puste = https://pznowak.pl).
SITE_URL=

# --- Zlecenie X: poczta z formularza (SMTP skrzynki pracowni), opis: cms/src/lib/email.ts ---
# Bez kompletu SMTP_HOST, SMTP_USER, SMTP_PASS i SMTP_FROM nic nie wychodzi (status „pominięte”).
# Serwer z panelu MyDevil, np. mail0.mydevil.net (na tę nazwę jest certyfikat TLS, nie na mail.pznowak.pl).
SMTP_HOST=
# 465 = TLS od początku (domyślnie); 587 = STARTTLS (wymagany); bez szyfrowania tylko serwer na localhost.
SMTP_PORT=465
# Login i hasło skrzynki, np. kontakt@pznowak.pl.
SMTP_USER=
SMTP_PASS=
# Nadawca: adres tej samej skrzynki co SMTP_USER (SPF i DKIM domeny).
SMTP_FROM="Formularz pznowak.pl <kontakt@pznowak.pl>"

# --- Zlecenie X: adres klienta do limitów zgłoszeń, opis: cms/src/lib/submissions/config.ts ---
# Puste = jak na Vercelu (x-real-ip, potem pierwszy wpis x-forwarded-for).
# MyDevil: cf-connecting-ip (gdy DNS idzie przez Cloudflare) albo x-forwarded-for.
CLIENT_IP_HEADER=
# Przy x-forwarded-for: ile zaufanych proxy dopisuje wpisy (1 = ostatni wpis).
CLIENT_IP_PROXY_HOPS=1

# --- Zlecenie X: potrzebne też na produkcji poza Vercelem (pomiń, jeśli są już wyżej w tym pliku) ---
# SUBMISSIONS_NOTIFY_TO=           adres, na który idą zgłoszenia z formularza
# SITE_ENV=production              ustawić już przy `next build`; wyłącza klucze testowe Turnstile
# SITE_URL=https://pznowak.pl      adres w linkach do panelu w mailach do pracowni

# --- Opinie Google (sekcja na stronie głównej i w Realizacjach), opis: cms/src/lib/google-places.ts ---
# Klucz Google Cloud z włączonym „Places API (New)”, ograniczony do tego API. Tylko po stronie serwera.
# Place ID wizytówki: `npm run google:place-id` (używa klucza). Bez obu zmiennych sekcja bierze ręczną
# konfigurację z src/lib/reviews.ts (dziś pustą: podgląd pokazuje placeholder, produkcja pomija sekcję).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Najniższa pokazywana ocena (puste = 4, czyli opinie 4 i 5 gwiazdek).
GOOGLE_REVIEWS_MIN_RATING=
